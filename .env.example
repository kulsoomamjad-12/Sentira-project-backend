PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
AI_API_KEY=
AI_PROVIDER=openai
CLIENT_URL=http://localhost:3000

# Nodemailer / SMTP config — used for critical-feedback alert emails and
# team invite emails. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=your address, SMTP_PASS=an App Password (not your login password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Apify — used to fetch comments off a social media post URL (Instagram,
# Facebook, YouTube, TikTok, LinkedIn) so they can run through the same AI
# sentiment analysis as every other review. Get a token from your Apify
# account: Settings -> Integrations -> API tokens (apify.com).
APIFY_TOKEN=
# Optional: how often the scheduler re-checks sources switched to
# "automatic" (cron syntax). Defaults to once an hour if unset. Requires a
# long-running process to actually fire (local/Render/Railway) — does not
# run on Vercel, since node-cron can't stay alive between serverless
# invocations there.
SOCIAL_IMPORT_CRON=0 * * * *
